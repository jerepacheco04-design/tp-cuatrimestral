<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="ClinicaTurnos.Web.Site" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Clínica médica</title>
    <link href="~/Content/Sitio.css" rel="stylesheet" runat="server" />
</head>
<body>
    <form id="formPrincipal" runat="server">
        <header>
            <h2>Clínica médica</h2>
            <nav id="navPrincipal" runat="server">
                <asp:HyperLink runat="server" NavigateUrl="~/Default.aspx" Text="Inicio" />
                <asp:PlaceHolder ID="pnlGestion" runat="server">
                    <asp:HyperLink runat="server" NavigateUrl="~/Pacientes.aspx" Text="Pacientes" />
                    <asp:HyperLink runat="server" NavigateUrl="~/Especialidades.aspx" Text="Especialidades" />
                    <asp:HyperLink runat="server" NavigateUrl="~/TurnosTrabajo.aspx" Text="Horarios de trabajo" />
                    <asp:HyperLink runat="server" NavigateUrl="~/Medicos.aspx" Text="Médicos" />
                    <asp:HyperLink runat="server" NavigateUrl="~/Turnos.aspx" Text="Turnos" />
                </asp:PlaceHolder>
                <asp:HyperLink ID="lnkMiAgenda" runat="server" NavigateUrl="~/MiAgenda.aspx" Text="Mi agenda" />
                <asp:LinkButton ID="btnCerrarSesion" runat="server" OnClick="btnCerrarSesion_Click">Cerrar sesión</asp:LinkButton>
            </nav>
        </header>
        <main>
            <asp:ContentPlaceHolder ID="ContenidoPrincipal" runat="server" />
        </main>
    </form>
</body>
</html>
